{
  "schema": "example",
  "context": {
    "contentFactory": "InMemoryContentFactory",
    "resolvers": ["disk"]
  },
  "operators": {
    "enumerator": {
      "factory": "FileSystemEnumerator",
      "parameters": {
        "path": "../example/demo-images/",
        "depth": "3",
        "mediaTypes": "IMAGE"
      }
    },
    "decoder": {
      "factory": "ImageDecoder"
    },
    "aggregator": {
      "factory": "MiddleContentAggregator"
    },
    "persister": {
      "factory": "PersistRetrievableTransformer"
    },
    "thumbnail": {
      "exporter": "thumbnail"
    },
    "averagecolor": {
      "field": "averagecolor"
    },
    "source": {
      "field": "file"
    }
  },
  "operations": {
    "enumerator": {
      "operator": "enumerator"
    },
    "decoder": {
      "operator": "decoder",
      "inputs": ["enumerator"]
    },
    "middle": {
      "operator": "aggregator",
      "inputs": ["decoder"]
    },
    "persist": {
      "operator": "persister",
      "inputs": ["middle"]
    },
    "thumbnail": {
      "operator": "thumbnail",
      "inputs": ["persist"]
    },
    "averagecolor": {
      "operator": "averagecolor",
      "inputs": ["thumbnail"]
    },
    "source": {
      "operator": "source",
      "inputs": ["averagecolor"]
    }
  },
  "output": [
    "source"
  ],
  "mergeType": "MERGE"
}